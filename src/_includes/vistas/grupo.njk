{% set pg = grsi.paginas.grupo %}
<section class="view" id="grupo" data-nav="grupo">

<header class="page-head"><p class="eyebrow">El grupo</p><h1>{{ pg.titulo }}</h1><p class="lead">{{ pg.bajada }}</p></header>
{{ m.maq("/el-grupo/", "El grupo: quiénes somos, historia y números · " + s.sigla, "Qué es el " + s.sigla + ", a qué institución pertenece, su misión, su historia y convenios desde " + s.desde + " y su producción por año.", "ResearchOrganization con los mismos datos de la ficha", grsi.jsonld.grupo) }}
<nav class="jump" aria-label="En esta página"><span class="eyebrow">En esta página</span><a class="chip" href="#ficha">Ficha</a><a class="chip" href="#mision">Misión y visión</a><a class="chip" href="#numeros">En números</a><a class="chip" href="#historia">Historia y convenios</a><a class="chip" href="#colegios">Colegios</a></nav>
<section class="block" id="ficha"><header class="bh"><h2>Ficha del grupo</h2></header>
<dl class="facts">
  <dt>Nombre</dt><dd>{{ s.nombre }} ({{ s.sigla }})</dd>
  <dt>Pertenencia</dt><dd>{{ s.departamento }}, {{ s.facultad }} ({{ s.facultad_sigla }}), {{ s.universidad }}</dd>
  <dt>Activo desde</dt><dd>{{ s.desde }}</dd>
  {% if grsi.direccion.length %}<dt>Dirección</dt><dd>{% for p in grsi.direccion %}{{ m.persona(p) }} ({{ p.rol | lower }}){% if not loop.last %} y {% endif %}{% endfor %}</dd>{% endif %}
  <dt>Líneas</dt><dd>{% for l in grsi.lineas %}{{ m.linea(l) }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
  <dt>Ubicación</dt><dd>{{ s.calle }}, {{ s.localidad }}, {{ s.pais }}</dd>
  <dt>Ficha oficial</dt><dd><a href="{{ s.ficha_oficial }}">Página del grupo en el sitio de la {{ s.facultad_sigla }}</a></dd>
</dl>
</section>
<section class="block" id="mision"><header class="bh"><h2>Misión, visión y objetivos</h2></header>
<div class="cols2">
  <div><h3>Misión</h3><p>{{ pg.mision }}</p></div>
  <div><h3>Visión</h3><p>{{ pg.vision }}</p></div>
</div>
<h3>Objetivos</h3>
<ol class="plain">{% for o in pg.objetivos %}<li>{{ o }}</li>{% endfor %}</ol>
<p class="nota"><b>Nota de diseño.</b> Un solo bloque corto. La portada no lo repite: sus dos líneas de presentación ya dicen la misión en lenguaje simple.</p>
</section>
<section class="block" id="numeros"><header class="bh"><h2>El {{ s.sigla }} en números</h2><span class="rev">Calculado al <time datetime="{{ grsi.hoy }}">{{ grsi.hoyTxt }}</time></span></header>
{{ m.numeros(grsi.numeros) }}
<div class="tbl-wrap"><table><thead><tr><th scope="col">Año</th><th scope="col">Publicaciones</th><th scope="col">Tesis dirigidas</th><th scope="col">Proyectos vigentes</th></tr></thead><tbody>{% for a in grsi.numeros.porAnio %}<tr><th scope="row">{{ a.anio }}</th><td class="num">{{ a.publicaciones }}</td><td class="num">{{ a.tesis }}</td><td class="num">{{ a.proyectos }}</td></tr>{% endfor %}</tbody></table></div>
</section>
<section class="block" id="historia"><header class="bh"><h2>Historia y convenios</h2></header><div class="timeline">{% for h in grsi.historia %}<div class="ev"><p class="yr">{{ h.anio }}</p><h3>{{ h.titulo }}</h3><p class="sub">{{ h.texto }}</p></div>{% endfor %}</div><p class="nota"><b>Nota de diseño.</b> Los convenios dejaron de ser una tabla aparte: cada uno es un hito de la línea de tiempo, en el año en que se firmó.</p></section>
<section class="block" id="colegios"><header class="bh"><h2>Visitas y charlas para colegios</h2></header>
<div class="grid two">
{% for c in pg.colegios %}  <article class="card"><h3>{{ c.titulo }}</h3><p class="meta">{{ c.texto }}</p></article>
{% endfor %}</div>
<div><a class="btn" href="#contacto" data-motivo="Colegio secundario">Coordinar una visita o una charla</a></div>
<p class="nota"><b>Nota de diseño.</b> Perfil nuevo, sumado por el grupo: docentes y directivos de colegios secundarios. Tiene un bloque acá, un destinatario en Contacto y un enlace en la portada, sin sección propia.</p>
</section>
<section class="block"><header class="bh"><h2>Últimas noticias</h2><a href="#noticias">Todas las noticias</a></header><div class="list">{% for n in grsi.noticias.slice(0, 3) %}{{ m.filaNoticia(n) }}{% endfor %}</div></section>
</section>
