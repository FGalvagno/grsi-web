{% set n = grsi.numeros %}
<section class="view" id="investigacion" data-nav="investigacion">

<header class="page-head"><p class="eyebrow">Investigación</p><h1>{{ grsi.paginas.investigacion.titulo }}</h1><p class="lead">{{ grsi.paginas.investigacion.bajada }}</p></header>
{{ m.maq("/investigacion/", "Líneas, proyectos y publicaciones · " + s.sigla, "Las " + n.lineas + " líneas de investigación del " + s.sigla + ", sus proyectos en curso y finalizados y todas sus publicaciones, con filtros por año, tipo y línea.", "CollectionPage con un ResearchProject por proyecto y un ScholarlyArticle, Chapter o Report por publicación", grsi.jsonld.investigacion) }}
<nav class="jump" aria-label="En esta página"><span class="eyebrow">En esta página</span><a class="chip" href="#lineas">Líneas ({{ n.lineas }})</a><a class="chip" href="#proyectos">Proyectos ({{ grsi.proyectos.length }})</a><a class="chip" href="#publicaciones">Publicaciones ({{ n.publicaciones }})</a></nav>
<p class="nota"><b>Nota de diseño.</b> Proyectos y Publicaciones dejaron de ser secciones: son dos bloques de esta página. Los proyectos ya no tienen página propia; se despliegan acá mismo.</p>
<section class="block" id="lineas"><header class="bh"><h2>Líneas de investigación</h2></header>
<div class="grid two">{% for l in grsi.lineas %}<a class="card cc c-inv" href="#linea-{{ l.id }}"><div class="chd"><p class="eyebrow">{{ l.sigla }}</p><h3>{{ l.nombre }}</h3></div><div class="cbd"><p class="meta">{{ l.resumen }}</p><div class="foot"><span class="meta">{{ l.pie }}</span>{% if l.revisado %}<span class="rev">Revisado <time datetime="{{ l.revisado }}">{{ l.revisadoTxt }}</time></span>{% endif %}</div></div></a>{% endfor %}</div></section>
<section class="block" id="proyectos"><header class="bh"><h2>Proyectos</h2><span class="rev">{{ n.proyectosEnCurso }} en curso · {{ n.proyectosFinalizados }} finalizados</span></header>
<div class="list">{% for x in grsi.proyectos %}<details class="proj" id="proyecto-{{ x.id }}"><summary><span class="pt"><b>{{ x.nombre }}</b><span class="sub sm">{{ x.resumen }}</span></span><span class="tags"><span class="pill {{ 'active' if x.enCurso else 'done' }}">{{ x.estado }}</span><span class="pill ">{{ x.tipo }}</span><span class="mono">{{ x.periodo }}</span></span></summary>
<div class="pd">{{ x.html | safe }}<dl class="kv">{% if x.financiador %}<dt>Financiamiento</dt><dd>{{ x.financiador }}{% if x.codigo %} · <span class="mono">{{ x.codigo }}</span>{% endif %}</dd>{% endif %}{% if x.director %}<dt>Dirección</dt><dd>{{ m.persona(x.director) }}</dd>{% endif %}<dt>Integrantes</dt><dd>{% for p in x.integrantes %}{{ m.persona(p) }}{% if not loop.last %}, {% endif %}{% endfor %}</dd><dt>Líneas</dt><dd>{% for l in x.lineas %}{{ m.linea(l) }}{% if not loop.last %}, {% endif %}{% endfor %}</dd><dt>Socios</dt><dd>{{ x.socios | join(", ") if x.socios.length else "Sin socios externos" }}</dd>{% if x.publicaciones.length %}<dt>Publicaciones</dt><dd>{% for b in x.publicaciones %}{{ b.titulo }} ({{ b.anio }}){% if not loop.last %}, {% endif %}{% endfor %}</dd>{% endif %}</dl></div></details>{% endfor %}</div>
</section>
<section class="block" id="publicaciones"><header class="bh"><h2>Publicaciones</h2><span class="rev js-only" id="pubCount"></span></header>
<div class="filters js-only">
  <label class="f" for="fTexto">Buscar en títulos y autores<input id="fTexto" type="search" placeholder="Título, autor o revista"></label>
  <label class="f" for="fAnio">Año<select id="fAnio"><option value="">Todos</option>{% for a in grsi.filtros.anios %}<option>{{ a }}</option>{% endfor %}</select></label>
  <label class="f" for="fTipo">Tipo<select id="fTipo"><option value="">Todos</option>{% for t in grsi.filtros.tipos %}<option>{{ t }}</option>{% endfor %}</select></label>
  <label class="f" for="fLinea">Línea<select id="fLinea"><option value="">Todas</option>{% for l in grsi.lineas %}<option value="{{ l.id }}">{{ l.nombre }}</option>{% endfor %}</select></label>
</div>
<div class="list" id="pubList">{% for b in grsi.publicaciones %}{{ m.filaPublicacion(b) }}{% endfor %}</div>
<p class="empty" id="pubEmpty" hidden>No hay publicaciones con esos filtros. Quitá alguno para ver más.</p>
<p class="sm sub">Las tesis y trabajos finales dirigidos están en <a href="#formados">Equipo</a>.</p>
</section>
</section>
